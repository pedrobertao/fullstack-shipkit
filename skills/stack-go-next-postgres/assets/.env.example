# backend
API_PORT=8080
ENV=dev
LOG_LEVEL=debug
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://app:app@localhost:5672/
JWT_SECRET=replace-with-32-random-bytes   # openssl rand -base64 32
FRONTEND_URL=http://localhost:3000

# frontend
API_URL=http://localhost:8080

# In production, set JWT_SECRET_FILE / DATABASE_URL_FILE / RABBITMQ_URL_FILE
# instead (a file path) and drop the plain vars above — see infra.md's
# "Secrets in production".
